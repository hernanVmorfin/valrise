{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "brand-blue", "name": "Brand Blue", "color": "#3DA2EF" },
        { "slug": "action-blue", "name": "Action Blue", "color": "#176DAA" },
        { "slug": "ivory", "name": "Warm Ivory", "color": "#F5F1E8" },
        { "slug": "paper", "name": "Paper", "color": "#FCFAF5" },
        { "slug": "charcoal", "name": "Charcoal", "color": "#181A1D" },
        { "slug": "neutral", "name": "Neutral Gray", "color": "#686A6D" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.5rem" },
        { "slug": "30", "name": "XS", "size": "0.875rem" },
        { "slug": "40", "name": "S", "size": "1.5rem" },
        { "slug": "50", "name": "M", "size": "clamp(2rem, 4vw, 3.5rem)" },
        { "slug": "60", "name": "L", "size": "clamp(3.5rem, 7vw, 6.5rem)" },
        { "slug": "70", "name": "XL", "size": "clamp(5rem, 10vw, 9rem)" }
      ],
      "units": ["px", "rem", "em", "vw", "%"]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "editorial",
          "name": "Editorial Serif",
          "fontFamily": "Iowan Old Style, Baskerville, Times New Roman, serif"
        },
        {
          "slug": "interface",
          "name": "Interface Sans",
          "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.8125rem" },
        { "slug": "body", "name": "Body", "size": "1rem" },
        { "slug": "lead", "name": "Lead", "size": "clamp(1.125rem, 1.7vw, 1.375rem)" },
        { "slug": "heading", "name": "Heading", "size": "clamp(2rem, 5vw, 4.5rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(3rem, 7vw, 6.75rem)" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|charcoal"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1.25rem, 4vw, 4rem)",
        "right": "clamp(1.25rem, 4vw, 4rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|interface",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "400",
          "letterSpacing": "-0.025em",
          "lineHeight": "1.02"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|action-blue" },
        ":hover": { "color": { "text": "var:preset|color|charcoal" } }
      },
      "button": {
        "border": { "radius": "0" },
        "color": {
          "background": "var:preset|color|action-blue",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": { "top": "0.9rem", "right": "1.4rem", "bottom": "0.9rem", "left": "1.4rem" }
        },
        "typography": {
          "fontSize": "0.8125rem",
          "fontWeight": "700",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontSize": "0.8125rem", "fontWeight": "650", "letterSpacing": "0.05em" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
