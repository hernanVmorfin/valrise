{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "valrise-consulting-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
